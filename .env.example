# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
LOG_LEVEL=debug

# --- Security -----------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=nyanoghar
JWT_AUDIENCE=nyanoghar-clients

# --- Postgres -----------------------------------------------------------
# Local docker-compose only; ignored when pointing at a hosted Postgres.
POSTGRES_USER=nyanoghar
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Two databases (see CLAUDE.md).
#
# Core — shared by identity / catalog / adoption / provider. Each service owns
# a named Postgres schema inside it (identity., catalog., adoption., provider.)
# and reads/writes only its own.
DATABASE_URL=postgres://nyanoghar:CHANGEME@localhost:5432/nyanoghar

# Chat — owned exclusively by the Go service.
CHAT_DATABASE_URL=postgres://nyanoghar:CHANGEME@localhost:5432/chat

DATABASE_POOL_MAX=10

# --- Redis / NATS -------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
NATS_URL=nats://localhost:4222
NATS_PORT=4222

# --- Gateway ------------------------------------------------------------
GATEWAY_PORT=4000
# Comma-separated list in production, e.g. https://app.nyanoghar.np
CORS_ORIGINS=*

# --- Service ports (local, non-Docker) ----------------------------------
# identity 4001 | catalog 4002 | adoption 4003 | provider 4004 | chat 8080

# --- Identity -----------------------------------------------------------
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Catalog ------------------------------------------------------------
LISTING_EXPIRY_DAYS=60
MAX_MEDIA_PER_PET=12

# --- Adoption -----------------------------------------------------------
MAX_OPEN_APPLICATIONS_PER_USER=5

# --- Provider -----------------------------------------------------------
APPOINTMENT_HORIZON_DAYS=90

# --- Media (S3 + CloudFront) --------------------------------------------
# Media never transits the API: clients PUT directly to S3 with a presigned
# URL and read public objects through CloudFront.
#
# The IAM key needs only s3:PutObject and s3:GetObject on the two buckets
# below — a presigned URL carries the signer's permissions, so scope it
# tightly.
MEDIA_S3_REGION=ap-south-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Approved listing photos. Kept private at the bucket level and read through
# CloudFront with an Origin Access Control.
MEDIA_PUBLIC_BUCKET=nyanoghar-media

# Verification documents and health records (spec 7.14, 17). Must be a
# separate bucket with "Block all public access" on and no CloudFront
# distribution: one bucket has one policy, and serving a document through the
# CDN would cache it at edge locations where deleting the object does not
# remove it.
MEDIA_PRIVATE_BUCKET=nyanoghar-media-private

# CloudFront domain for public reads, no scheme. Applied at read time only —
# rows store the S3 key, so replacing the distribution needs no data change.
MEDIA_CDN_DOMAIN=

# Presigned URL lifetimes. Short by design; the URL is used immediately.
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_PRIVATE_URL_TTL_SECONDS=300

# 10 MiB. Signed into the upload URL, so S3 enforces it independently.
MEDIA_MAX_UPLOAD_BYTES=10485760
