# Copy to .env and you are done — every value here works out of the box
# against `pnpm infra:up`. Never commit the real .env.
#
#   cp .env.example .env
#
# The defaults are development-only and deliberately not secret. Before
# deploying anywhere reachable, replace at minimum JWT_ACCESS_SECRET,
# POSTGRES_PASSWORD and DATABASE_URL.

NODE_ENV=development
LOG_LEVEL=debug

# --- Security -----------------------------------------------------------
# Must be at least 32 characters. The value below is a placeholder shared by
# every clone of this repo — fine for localhost, unacceptable anywhere else.
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-secret-do-not-use-in-production-0123456789
JWT_ACCESS_TTL=15m
JWT_ISSUER=nyanoghar
JWT_AUDIENCE=nyanoghar-clients

# --- Postgres -----------------------------------------------------------
# Matches the docker-compose defaults, so `pnpm infra:up` and these values
# agree with no editing. Ignored when DATABASE_URL points at a hosted
# Postgres (Neon, RDS, ...).
POSTGRES_USER=nyanoghar
POSTGRES_PASSWORD=nyanoghar
POSTGRES_PORT=5432

# Two databases (see CLAUDE.md).
#
# Core — shared by identity / catalog / adoption / provider. Each module owns
# a named Postgres schema inside it (identity., catalog., adoption., provider.)
# and reads/writes only its own.
DATABASE_URL=postgres://nyanoghar:nyanoghar@localhost:5432/nyanoghar

# Chat — owned exclusively by the Go service.
CHAT_DATABASE_URL=postgres://nyanoghar:nyanoghar@localhost:5432/chat

DATABASE_POOL_MAX=10

# --- Redis / NATS -------------------------------------------------------
# Not yet used by any code path: Redis has no client and nothing publishes to
# NATS (see "Known gaps" in the README). The URLs are validated at startup, so
# they must be present and well-formed, but the services need not be running
# for `pnpm dev` to work.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
NATS_URL=nats://localhost:4222
NATS_PORT=4222

# --- HTTP ---------------------------------------------------------------
PORT=4000
GATEWAY_PORT=4000
# Comma-separated list in production, e.g. https://app.nyanoghar.np
CORS_ORIGINS=*

# --- Identity -----------------------------------------------------------
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Catalog ------------------------------------------------------------
LISTING_EXPIRY_DAYS=60
MAX_MEDIA_PER_PET=12

# --- Adoption -----------------------------------------------------------
MAX_OPEN_APPLICATIONS_PER_USER=5

# --- Provider -----------------------------------------------------------
APPOINTMENT_HORIZON_DAYS=90

# --- Media (S3-compatible storage) --------------------------------------
# OPTIONAL, and all-or-nothing: set the five MEDIA_S3_ACCESS_KEY_ID /
# MEDIA_S3_SECRET_ACCESS_KEY / MEDIA_PUBLIC_BUCKET / MEDIA_PRIVATE_BUCKET /
# MEDIA_CDN_DOMAIN values together, or none of them. A partial set is
# rejected at startup — a deploy that silently stored nothing would be worse
# than failing to boot.
#
# There are three ways to run:
#
#   1. NOTHING SET (the default below). The service starts with a stub driver,
#      every non-media route works normally, and upload routes answer 501.
#      Choose this if you are not touching media.
#
#   2. LOCAL MINIO — no AWS account, uploads genuinely work. Run
#      `pnpm infra:up:media` and uncomment the MinIO block below. S3 is a
#      protocol, so this exercises the same code path as production.
#
#   3. REAL S3 (or Cloudflare R2 / Backblaze B2 / DigitalOcean Spaces). Fill
#      in your own credentials; set MEDIA_S3_ENDPOINT for non-AWS providers.
#      The IAM key needs only s3:PutObject and s3:GetObject on the two
#      buckets — a presigned URL carries the signer's permissions, so scope
#      it tightly.
MEDIA_S3_REGION=ap-south-1

# --- Option 2: local MinIO (uncomment this whole block) ------------------
# These match the docker-compose defaults, so `pnpm infra:up:media` and these
# values agree with no editing.
# MEDIA_S3_ACCESS_KEY_ID=nyanoghar-local-key
# MEDIA_S3_SECRET_ACCESS_KEY=nyanoghar-local-secret-000000000000
# MEDIA_PUBLIC_BUCKET=nyanoghar-media
# MEDIA_PRIVATE_BUCKET=nyanoghar-media-private
# MinIO stands in for the CDN locally: public reads go straight to the bucket.
# MEDIA_CDN_DOMAIN=localhost:9000/nyanoghar-media
# MEDIA_S3_ENDPOINT=http://localhost:9000
# A bucket subdomain does not resolve on localhost, so address by path.
# MEDIA_S3_FORCE_PATH_STYLE=true

# --- Option 3: real S3 / R2 / B2 / Spaces --------------------------------
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
#
# Approved listing photos. Kept private at the bucket level and read through
# CloudFront with an Origin Access Control.
# MEDIA_PUBLIC_BUCKET=nyanoghar-media
#
# Verification documents and health records (spec 7.14, 17). Must be a
# separate bucket with "Block all public access" on and no CloudFront
# distribution: one bucket has one policy, and serving a document through the
# CDN would cache it at edge locations where deleting the object does not
# remove it.
# MEDIA_PRIVATE_BUCKET=nyanoghar-media-private
#
# CloudFront domain for public reads, no scheme. Applied at read time only —
# rows store the S3 key, so replacing the distribution needs no data change.
# MEDIA_CDN_DOMAIN=
#
# Leave unset for real AWS. Set for any S3-compatible provider, e.g.
# https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=false

# Presigned URL lifetimes. Short by design; the URL is used immediately.
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_PRIVATE_URL_TTL_SECONDS=300

# 10 MiB. Signed into the upload URL, so S3 enforces it independently.
MEDIA_MAX_UPLOAD_BYTES=10485760
