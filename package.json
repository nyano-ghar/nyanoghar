{
  "name": "nyanoghar-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./services/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nyanoghar/core-api dev",
    "db:generate": "pnpm --filter @nyanoghar/core-api db:generate",
    "db:migrate": "pnpm --filter @nyanoghar/core-api db:migrate",
    "db:studio": "pnpm --filter @nyanoghar/core-api db:studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis nats",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "stack:up": "docker compose -f infra/docker-compose.yml up --build",
    "proto:gen": "buf generate packages/contracts/proto"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
