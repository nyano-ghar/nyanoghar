{
  "name": "nyanoghar-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./services/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nyanoghar/core-api dev",
    "db:generate": "pnpm --filter @nyanoghar/core-api db:generate",
    "db:migrate": "pnpm --filter @nyanoghar/core-api db:migrate",
    "db:studio": "pnpm --filter @nyanoghar/core-api db:studio",
    "db:seed": "pnpm --filter @nyanoghar/core-api db:seed",
    "setup": "pnpm --filter \"./packages/**\" build && pnpm db:migrate && pnpm db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "infra:up:media": "docker compose -f infra/docker-compose.yml up -d postgres minio minio-init",
    "infra:up:all": "docker compose -f infra/docker-compose.yml up -d postgres redis nats minio minio-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "stack:up": "docker compose -f infra/docker-compose.yml up --build",
    "proto:gen": "buf generate packages/contracts/proto"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
